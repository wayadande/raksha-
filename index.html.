<!DOCTYPE html>
<html lang="en"><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Happy Birthday, Pitch!</title>
<style>
:root{--bg:#fbe3ea;--ink:#7a1f3d;--btn:#b3254f;--btnt:#fff}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){--bg:#2a0f1a;--ink:#ffd9e4;--btn:#e0527d;--btnt:#2a0f1a}}
:root[data-theme="dark"]{--bg:#2a0f1a;--ink:#ffd9e4;--btn:#e0527d;--btnt:#2a0f1a}
*{box-sizing:border-box;-webkit-tap-highlight-color:transparent}
html,body{height:100%;margin:0;background:var(--bg);color:var(--ink);font-family:Georgia,'Times New Roman',serif;overflow:hidden}
body{display:flex;align-items:center;justify-content:center}
#card{position:relative;width:min(100vw,calc(100dvh*9/16));aspect-ratio:9/16;overflow:hidden;background:#000}
.pg{position:absolute;inset:0;transition:opacity .9s,transform 1.1s}
.pg img.bg{width:100%;height:100%;display:block;object-fit:cover;pointer-events:none}
.pg.hide{opacity:0;pointer-events:none}
.ui{position:absolute;left:0;right:0;text-align:center;padding:0 6%}
.btn{font:600 clamp(15px,4.4vw,20px) Georgia,serif;background:var(--btn);color:var(--btnt);border:0;border-radius:999px;padding:.8em 1.6em;box-shadow:0 6px 18px rgba(120,20,60,.35);cursor:pointer}
.btn.ghost{background:rgba(255,255,255,.85);color:#7a1f3d;margin-top:.6em;font-weight:500;font-size:clamp(13px,3.6vw,16px)}
.tip{font:italic clamp(16px,4.6vw,22px) Georgia,serif;color:#7a1f3d;text-shadow:0 1px 0 rgba(255,255,255,.7);margin:0 0 .7em}
#p1 .ui{bottom:calc(7% + env(safe-area-inset-bottom,0px));animation:bob 2.4s ease-in-out infinite}
@keyframes bob{50%{transform:translateY(-6px)}}
.flame{position:absolute;width:14%;height:12%;transform:translate(-50%,-50%);cursor:pointer;touch-action:manipulation}
.flame i{display:block;position:absolute;left:50%;bottom:31%;width:22%;height:38%;margin-left:-11%;border-radius:50% 50% 50% 50%/65% 65% 35% 35%;background:radial-gradient(circle at 50% 75%,#fffbd0 0,#ffd04a 40%,#ff7a2f 100%);box-shadow:0 0 22px 8px rgba(255,170,60,.55);transform-origin:50% 100%;opacity:0;transform:scale(.1);transition:opacity .35s calc(var(--i,0)*.15s),transform .45s calc(var(--i,0)*.15s)}
.flame.on i{opacity:1;transform:scale(1);animation:fl .18s .5s infinite alternate}
.flame.smoke i{animation:bo .55s forwards}
@keyframes fl{from{transform:scaleY(.92) rotate(-3deg)}to{transform:scaleY(1.08) rotate(3deg)}}
@keyframes bo{0%{opacity:1;transform:scale(1)}40%{opacity:.9;transform:rotate(28deg) scale(.8) skewX(30deg)}100%{opacity:0;transform:rotate(40deg) scale(.2,.1)}}
.flame.smoke::before{content:"";position:absolute;left:45%;bottom:30%;width:10%;height:9%;border-radius:50%;background:#ff9a3c;box-shadow:0 0 8px 3px rgba(255,140,60,.7);animation:ember 1.6s both}
@keyframes ember{to{opacity:0;transform:scale(.3)}}
.flame.smoke::after{content:"";position:absolute;left:42%;bottom:30%;width:16%;height:16%;border-radius:50%;background:radial-gradient(ellipse,rgba(255,255,255,.9),rgba(200,200,210,.4) 60%,transparent 72%);filter:blur(3px);opacity:0;animation:smoke 2.4s .25s ease-out both}
@keyframes smoke{0%{opacity:.9;transform:translate(0,0) scaleY(.4)}35%{opacity:.8;transform:translate(-35%,-70%) scaleY(1.2)}100%{opacity:0;transform:translate(40%,-260%) scale(2,1.6)}}
#p2 .ui{top:calc(24% + env(safe-area-inset-top,0px))}
#p2.dim::before{content:"";position:absolute;inset:0;background:rgba(40,0,30,.0);transition:background 1s;pointer-events:none}
#p2.done::before{background:rgba(40,0,30,.18)}
#p3 .ui{bottom:calc(5% + env(safe-area-inset-bottom,0px))}
#seal{position:absolute;left:68.5%;top:47.2%;width:30%;aspect-ratio:1;transform:translate(-50%,-50%);border-radius:50%;border:0;background:transparent;cursor:pointer;animation:pulse 1.6s infinite}
@keyframes pulse{0%{box-shadow:0 0 0 0 rgba(255,255,255,.8)}100%{box-shadow:0 0 0 28px rgba(255,255,255,0)}}
#p3.open #env{opacity:0;transform:translateY(-7%) scale(1.08)}
#env{transition:opacity 1s .15s,transform 1.2s}
#p4{opacity:0;transform:scale(.88);pointer-events:none;overflow-y:auto;background:#f3dfe3}
#p4.show{opacity:1;transform:none;pointer-events:auto}
#p4 img{width:100%;display:block}
#conf{position:absolute;inset:0;pointer-events:none;z-index:9}
#again{position:absolute;right:3%;top:calc(2% + env(safe-area-inset-top,0px));z-index:8;opacity:0;pointer-events:none;transition:opacity .6s 1.5s;font-size:13px;padding:.5em 1em}
#again.show{opacity:1;pointer-events:auto}
@media (prefers-reduced-motion:reduce){*{animation:none!important}}
</style></head>
<body>
<div id="card">
  <section class="pg" id="p1">
    <img class="bg" src="data:image/jpeg;base64," alt="Birthday photo">
    <div class="ui"><button class="btn" id="go1">Open your birthday card</button></div>
  </section>

  <section class="pg hide" id="p2">
    <img class="bg" src="data:image/jpeg;base64," alt="Birthday cake">
    <div class="flame" style="left:32.6%;top:47.4%"><i></i></div>
    <div class="flame" style="left:47.6%;top:47.4%"><i></i></div>
    <div class="flame" style="left:66%;top:47.4%"><i></i></div>
    <div class="flame" style="left:79.9%;top:47.9%"><i></i></div>
    <div class="ui" id="u2">
      <p class="tip" id="tip">Tap the candles to light them</p>
      <div id="meter" style="height:6px;width:50%;margin:.2em auto .7em;background:rgba(255,255,255,.6);border-radius:9px;overflow:hidden;opacity:0;transition:opacity .4s"><div id="lv" style="height:100%;width:0;background:#e0527d"></div></div>
      <button class="btn" id="mic">Blow with your breath</button><br>
      <button class="btn ghost" id="tap">Or tap to blow</button>
    </div>
    <div class="ui" id="u2b" style="display:none;top:calc(24% + env(safe-area-inset-top,0px))">
      <p class="tip" style="font-size:clamp(20px,6vw,28px)">🎂 Happy Birthday, Pitch! 🎂<br><span style="font-size:.65em">Wish made, now one more thing&hellip; ✨</span></p>
      <button class="btn" id="go2">Open your letter</button>
    </div>
  </section>

  <section class="pg hide" id="p3">
    <div id="env" style="position:absolute;inset:0"><img class="bg" src="data:image/jpeg;base64," alt="Sealed letter"></div>
    <button id="seal" aria-label="Break the seal"></button>
    <div class="ui"><p class="tip" id="t3" style="background:rgba(255,255,255,.75);border-radius:12px;display:inline-block;padding:.3em .9em">Tap the wax seal</p></div>
  </section>

  <section class="pg" id="p4"><img src="data:image/jpeg;base64," alt="Your letter"></section>
  <button class="btn ghost" id="again">Replay</button>
  <canvas id="conf"></canvas>
</div>
<script>
const $=s=>document.querySelector(s), show=id=>{document.querySelectorAll('.pg').forEach(p=>{if(p.id!=='p4')p.classList.add('hide')});$(id).classList.remove('hide')};
const flames=[...document.querySelectorAll('.flame')];
let stream,ctx,raf,blowT=0,finished=false;
const cv=$('#conf'),g=cv.getContext('2d');let parts=[];
function size(){const r=cv.parentElement.getBoundingClientRect();cv.width=r.width;cv.height=r.height}
addEventListener('resize',size);size();
function confetti(n=140,fromY=.4){const cols=['#ff6fa0','#ffd166','#2ec4b6','#ef476f','#fff','#b980f0'];for(let i=0;i<n;i++)parts.push({x:cv.width/2,y:cv.height*fromY,vx:(Math.random()-.5)*14,vy:-Math.random()*14-3,s:5+Math.random()*7,c:cols[i%6],r:Math.random()*6,vr:(Math.random()-.5)*.4});if(!parts.length||!confetti.on){confetti.on=1;loop()}}
function loop(){g.clearRect(0,0,cv.width,cv.height);parts.forEach(p=>{p.x+=p.vx;p.y+=p.vy;p.vy+=.28;p.vx*=.99;p.r+=p.vr;g.save();g.translate(p.x,p.y);g.rotate(p.r);g.fillStyle=p.c;g.fillRect(-p.s/2,-p.s/3,p.s,p.s*.6);g.restore()});parts=parts.filter(p=>p.y<cv.height+20);if(parts.length)requestAnimationFrame(loop);else confetti.on=0}
const anyLit=()=>flames.some(f=>f.classList.contains('on'));
let celebrated=false,micOn=false,blowMs=0;
function btn(){$('#tap').textContent=anyLit()?'Or tap to blow':'Tap to light the candles'}
function light(){flames.forEach((f,i)=>{f.style.setProperty('--i',i);f.classList.remove('smoke');f.classList.add('on')});$('#p2').classList.remove('done');$('#tip').textContent='Make a wish, then blow out the candles';btn()}
function snuffOne(){const f=flames.find(x=>x.classList.contains('on'));if(!f)return;f.classList.remove('on');f.classList.add('smoke');if(navigator.vibrate)navigator.vibrate(25);after()}
function blowAll(){flames.forEach((f,i)=>setTimeout(()=>{if(f.classList.contains('on')){f.classList.remove('on');f.classList.add('smoke');after()}},i*140))}
function after(){btn();if(anyLit())return;$('#p2').classList.add('done');$('#tip').textContent='Tap the candles to light them again';
  if(!celebrated){celebrated=true;$('#u2b').style.display='block';setTimeout(()=>{confetti(220);setTimeout(()=>confetti(120,.3),700)},500)}else confetti(70)}
function stopMic(){cancelAnimationFrame(raf);if(stream)stream.getTracks().forEach(t=>t.stop());if(ctx)ctx.close();micOn=false}
const toggle=()=>anyLit()?blowAll():light();
flames.forEach(f=>f.addEventListener('click',toggle));
$('#tap').onclick=toggle;
$('#go1').onclick=()=>{flames.forEach(f=>f.classList.remove('on','smoke'));show('#p2');$('#tip').textContent='Tap the candles to light them';btn()};
$('#mic').onclick=async()=>{
  if(micOn)return;
  try{
    stream=await navigator.mediaDevices.getUserMedia({audio:{echoCancellation:false,noiseSuppression:false,autoGainControl:false}});
    ctx=new (window.AudioContext||window.webkitAudioContext)();await ctx.resume();
    const an=ctx.createAnalyser();an.fftSize=2048;an.smoothingTimeConstant=.3;ctx.createMediaStreamSource(stream).connect(an);
    micOn=true;$('#mic').style.display='none';$('#meter').style.opacity=1;
    $('#tip').textContent=anyLit()?'Listening… blow towards your phone':'Listening… light the candles, then blow';
    const td=new Float32Array(an.fftSize),fd=new Float32Array(an.frequencyBinCount),hz=ctx.sampleRate/an.fftSize,bin=f=>Math.round(f/hz);
    const l0=bin(40),l1=bin(1000),h1=Math.min(fd.length-1,bin(8000));
    let base=0,n=0,start=performance.now(),last=start;
    const tick=t=>{
      an.getFloatTimeDomainData(td);let s=0;for(const v of td)s+=v*v;const rms=Math.sqrt(s/td.length);
      an.getFloatFrequencyData(fd);
      let low=0,tot=0,lg=0,lc=0;
      for(let i=l0;i<=h1;i++){const p=Math.pow(10,fd[i]/10);tot+=p;if(i<=l1){low+=p;lg+=Math.log(p+1e-20);lc++}}
      const lowRatio=low/(tot+1e-20),flat=Math.exp(lg/lc)/(low/lc+1e-20),dt=t-last;last=t;
      if(t-start<900){base+=rms;n++}
      else{
        const lim=Math.max(.04,(base/n)*3.5),isBlow=rms>lim&&lowRatio>.5&&flat>.12;
        $('#lv').style.width=Math.min(100,rms/lim*50)+'%';
        window.__dbg={rms,lim,lowRatio,flat,isBlow};
        if(isBlow&&anyLit()){blowMs+=dt;if(blowMs>300){blowMs=150;snuffOne()}}else blowMs=Math.max(0,blowMs-dt)
      }
      raf=requestAnimationFrame(tick)};
    raf=requestAnimationFrame(tick);
  }catch(e){$('#tip').textContent='Microphone not available. Tap the candles instead'}
};
$('#go2').onclick=()=>{stopMic();show('#p3')};
$('#seal').onclick=()=>{$('#seal').style.display='none';$('#t3').parentElement.style.display='none';$('#p3').classList.add('open');confetti(70,.5);
  setTimeout(()=>{$('#p4').classList.add('show');$('#p4').scrollTop=0;$('#again').classList.add('show')},700)};
$('#again').onclick=()=>{location.hash='';location.reload()};
</script></body></html>
